# 全站缓存上限 1 天（站点静态资产；/api/* 与 /hub/* 由 Worker 响应头控制，不走本文件）
# Cloudflare Workers Assets 读取本文件；EdgeOne 的等效配置在仓库根 edgeone.json
/*
  Cache-Control: public, max-age=86400

# HTML 入口短缓存：部署后 5 分钟内全量生效（仍不超过 1 天上限）
/index.html
  Cache-Control: public, max-age=300

/hub.html
  Cache-Control: public, max-age=300
